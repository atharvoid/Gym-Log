+    if (_query.isEmpty) {
+      matches.sort((a, b) => (a.routine.id == suggestion?.routine.routine.id
+              ? -2
+              : a.routine.id == chosen
+                  ? -1
+                  : 0)
+          .compareTo(b.routine.id == suggestion?.routine.routine.id
+              ? -2
+              : b.routine.id == chosen
+                  ? -1
+                  : 0));
+    }
+    final page =
+        _page.clamp(0, matches.isEmpty ? 0 : (matches.length - 1) ~/ 4);
