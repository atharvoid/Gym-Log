+      for (final name in [
+        'chosen',
+        'no-choice',
+        'deleted-choice',
+        'empty-choice',
+        'new-user',
+        'no-routine',
+        'inactive-return',
+        'low-data',
+        'error',
+        'previous-error',
+        'choice-error',
+        'loading',
+        'active-chosen',
+        'active-no-choice',
