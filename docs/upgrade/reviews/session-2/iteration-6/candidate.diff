+                              ? null
+                              : () => setState(() => _page = page + 1),
+                          icon: const Icon(Icons.chevron_right_rounded)),
+                    ]),
+                  if (_saving) const LinearProgressIndicator(),
+                  if (_error != null)
+                    Semantics(
+                        liveRegion: true,
+                        child: Text(_error!,
+                            style: AppText.body(color: s.textPrimary))),
+                ]))));
+  }
+}
