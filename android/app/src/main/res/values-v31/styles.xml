<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) splash screen.

  On API 31+ the OS draws its OWN splash on every cold start. This is not
  optional and it is not the same surface as `launch_background.xml`. If it is
  left unstyled it uses platform defaults, which on a black app looks like a
  stray screen belonging to someone else's brand.

  Styling it to the app's own background + launcher icon makes the sequence
  read as one continuous launch:

    OS splash (black + icon)  ->  window background (black)  ->  first frame

  `android:windowSplashScreenAnimatedIcon` deliberately reuses @mipmap/ic_launcher
  rather than a new asset, so there is exactly one icon to keep in sync. Note the
  OS masks and insets this icon; if it looks cropped, supply a dedicated
  drawable sized to the 240dp/160dp icon spec instead of enlarging the launcher.
-->
<resources>
    <!-- Theme applied to the Android Window while the process is launching. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!--
          Hands the window off to NormalTheme when the splash dismisses. Without
          this the OS keeps LaunchTheme, and the re-theme that Flutter performs a
          frame later is visible as a flicker.
        -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Theme applied once Flutter owns the surface. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
