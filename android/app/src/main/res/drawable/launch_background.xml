<?xml version="1.0" encoding="utf-8"?>
<!--
  Window background painted by Android between process start and Flutter's first
  frame.

  MUST match AppColors.bgBase (#000000). It was @android:color/white, which
  produced a white flash on every cold start of a pure-black app - the flash
  users read as "a logo/splash screen from somewhere else".

  If you ever add a brand mark here, add it as a second <item> with a bitmap and
  gravity="center", and mirror it in values-v31/styles.xml so Android 12+ shows
  the same thing. Divergence between those two files is the usual cause of a
  double-splash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
</layer-list>
